# find_real_funds.py
# پیدا کردن صندوق‌های واقعی
# اجرا: python find_real_funds.py

import os
import sys
import json
from pathlib import Path

if os.name == 'nt':
    os.system('chcp 65001 >nul 2>&1')

try:
    if hasattr(sys.stdout, 'reconfigure'):
        sys.stdout.reconfigure(encoding='utf-8', errors='ignore')
except:
    pass

PROJECT_ROOT = Path(r"F:\python\har roz ba python\smart_bours")
sys.path.insert(0, str(PROJECT_ROOT))

import algotik_tse as att


def safe_print(text):
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode('ascii', errors='ignore').decode('ascii'))


def main():
    safe_print("")
    safe_print("=" * 100)
    safe_print("  🔍 پیدا کردن صندوق‌های واقعی")
    safe_print("=" * 100)
    safe_print("")

    df = att.get_live_market()
    if df is None or df.empty:
        safe_print("  ❌ خطا")
        return

    safe_print(f"  📊 {len(df)} سهم")
    safe_print("")

    # جستجوی صندوق‌ها با نشانه‌های خاص
    fund_patterns = [
        "صندوق",
        "اهرمی",
        "اهرمي",
        "درآمد ثابت",
        "درامد ثابت",
        "سهامی",
        "سهامي",
        "شاخصی",
        "شاخص",
        "کالایی",
        "مختلط",
        "بخشی",
        "س.س",
        "س.ا",
        "س.ط",
        "س.ک",
        "س.پ",
    ]

    funds = []

    for _, row in df.iterrows():
        symbol = str(row.get("Symbol", ""))
        name = str(row.get("Name", ""))

        if not symbol or not name:
            continue

        # حذف حق تقدم
        if symbol.endswith("3") or symbol.endswith("ح"):
            continue

        # چک نشانه‌های صندوق
        for pattern in fund_patterns:
            if pattern in name or pattern in symbol:
                funds.append({
                    "symbol": symbol,
                    "name": name,
                    "ins_code": str(row.get("InsCode") or ""),
                    "match": pattern,
                })
                break

    safe_print(f"  ✅ {len(funds)} صندوق پیدا شد")
    safe_print("")

    # نمایش
    for f in funds[:50]:
        safe_print(f"     {f['symbol']:15} | {f['name'][:50]:50} | {f['match']}")

    safe_print("")

    # ذخیره
    output = PROJECT_ROOT / "data" / "real_funds.json"
    with open(output, "w", encoding="utf-8") as f:
        json.dump(funds, f, ensure_ascii=False, indent=2)

    safe_print(f"  💾 ذخیره: {output}")
    safe_print("")
    safe_print("=" * 100)


if __name__ == "__main__":
    main()
